page {
  background: #F5F6FA;
  font-size: 28rpx;
  color: #1F2329;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", "PingFang SC", "Microsoft YaHei", sans-serif;
}

view, text, input, textarea, button, image {
  box-sizing: border-box;
}

.card {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 24rpx;
  margin: 0 24rpx 24rpx;
}

.btn-primary {
  background: #4F46E5;
  color: #FFFFFF;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
  line-height: 2.6;
}

.btn-primary::after {
  border: none;
}

.btn-plain {
  background: transparent;
  color: #4F46E5;
  border: 2rpx solid #4F46E5;
  border-radius: 44rpx;
  font-size: 30rpx;
  line-height: 2.4;
}

.btn-plain::after {
  border: none;
}

.btn-disabled {
  background: #C7CBD9;
  color: #FFFFFF;
}

.tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  background: rgba(79, 70, 229, 0.1);
  color: #4F46E5;
}

.tag-green {
  background: rgba(16, 185, 129, 0.12);
  color: #0EA371;
}

.tag-gray {
  background: #F0F1F5;
  color: #6B7280;
}

.price {
  color: #FF4D4F;
  font-weight: 700;
}

.empty {
  padding: 120rpx 0;
  text-align: center;
  color: #9AA0A6;
  font-size: 26rpx;
}

.row {
  display: flex;
  align-items: center;
}

.flex-1 {
  flex: 1;
  min-width: 0;
}

.input {
  background: #F5F6FA;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  font-size: 28rpx;
}

.safe-bottom {
  padding-bottom: env(safe-area-inset-bottom);
}
