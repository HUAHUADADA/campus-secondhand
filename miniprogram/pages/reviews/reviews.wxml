<view class="page" wx:if="{{mode === 'form'}}">
  <view class="card" wx:if="{{order}}">
    <view class="order-info">商品：{{order.goodsTitle}}</view>
    <view class="row">
      <text class="order-price">￥{{order.priceText}}</text>
    </view>
  </view>

  <view class="card">
    <view class="label">交易体验</view>
    <view class="stars">
      <text wx:for="{{[1,2,3,4,5]}}" wx:key="*this"
        class="star {{star >= item ? 'star-on' : ''}}"
        data-star="{{item}}" bindtap="onStar">★</text>
    </view>
  </view>

  <view class="card">
    <view class="label">评价内容</view>
    <textarea class="input textarea" placeholder="卖家靠谱吗？商品和描述一致吗？" maxlength="200" value="{{content}}" bindinput="onContent" />
  </view>

  <view class="submit-wrap">
    <button class="btn-primary" bindtap="onSubmit" disabled="{{submitting}}">提交评价</button>
  </view>
</view>

<view class="page" wx:else>
  <view wx:for="{{list}}" wx:key="_id" class="review-card">
    <view class="row">
      <text class="stars-small">
        <text wx:for="{{[1,2,3,4,5]}}" wx:for-item="s" wx:key="*this" class="{{s <= item.star ? 'star-on' : ''}}">★</text>
      </text>
      <text class="review-time">{{item.timeText}}</text>
    </view>
    <view class="review-content">{{item.content}}</view>
    <view class="review-target">商品：{{item.goodsTitle}}</view>
  </view>
  <view wx:if="{{!list.length}}" class="empty">
    <view>还没有评价</view>
    <view class="empty-sub">完成交易后，双方都可以互相评价</view>
  </view>
</view>
