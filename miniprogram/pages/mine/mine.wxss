.page {
  padding: 24rpx;
}

.user-card {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #4F46E5 0%, #7C6FFF 100%);
  border-radius: 24rpx;
  padding: 40rpx 32rpx;
  margin-bottom: 24rpx;
  color: #FFFFFF;
}

.avatar {
  width: 110rpx;
  height: 110rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.25);
  font-size: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.user-name {
  font-size: 34rpx;
  font-weight: 700;
}

.user-sub {
  font-size: 24rpx;
  opacity: 0.85;
  margin-top: 8rpx;
}

.points {
  text-align: center;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 16rpx;
  padding: 12rpx 24rpx;
}

.points-num {
  font-size: 36rpx;
  font-weight: 700;
}

.points-label {
  font-size: 20rpx;
  opacity: 0.9;
}

.guest-card {
  background: linear-gradient(135deg, #6B7280 0%, #9AA0A6 100%);
}

.sign-card {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.sign-title {
  font-size: 30rpx;
  font-weight: 700;
}

.sign-sub {
  font-size: 22rpx;
  color: #9AA0A6;
  margin-top: 6rpx;
}

.sign-btn {
  padding: 0 40rpx;
  font-size: 26rpx;
  line-height: 2.4;
}

.menu-card {
  padding: 0 24rpx;
  margin-bottom: 24rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 2rpx solid #F0F1F5;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 14rpx;
  background: rgba(79, 70, 229, 0.1);
  color: #4F46E5;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
}

.menu-name {
  flex: 1;
  font-size: 30rpx;
}

.menu-arrow {
  color: #C7CBD9;
  font-size: 36rpx;
}

.footer {
  text-align: center;
  font-size: 22rpx;
  color: #C7CBD9;
  padding: 32rpx 0 48rpx;
}
