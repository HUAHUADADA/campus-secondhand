<view class="page">
  <view class="logo-area">
    <view class="logo">闲</view>
    <view class="app-name">校园闲置汇</view>
    <view class="app-sub">本校学生闲置交易 · 线下当面成交</view>
  </view>

  <view class="tabs">
    <view class="tab {{mode === 'login' ? 'active' : ''}}" bindtap="switchMode" data-mode="login">登录</view>
    <view class="tab {{mode === 'register' ? 'active' : ''}}" bindtap="switchMode" data-mode="register">注册</view>
  </view>

  <view class="card form-card">
    <block wx:if="{{mode === 'login'}}">
      <view class="field">
        <view class="label">学号</view>
        <input class="input" placeholder="请输入学号" value="{{loginStudentNo}}" bindinput="onLoginStudentNo" />
      </view>
      <view class="field">
        <view class="label">密码</view>
        <input class="input" password placeholder="请输入密码" value="{{loginPassword}}" bindinput="onLoginPassword" />
      </view>
      <button class="btn-primary login-btn" bindtap="onLogin" disabled="{{submitting}}">登录</button>
      <view class="forgot" bindtap="showForgot">忘记密码？</view>
    </block>

    <block wx:else>
      <view class="field">
        <view class="label">学号</view>
        <input class="input" placeholder="请输入学号" value="{{regStudentNo}}" bindinput="onRegStudentNo" />
      </view>
      <view class="field">
        <view class="label">真实姓名</view>
        <input class="input" placeholder="请输入真实姓名" value="{{regName}}" bindinput="onRegName" />
      </view>
      <view class="field">
        <view class="label">手机号</view>
        <input class="input" type="number" maxlength="11" placeholder="请输入手机号" value="{{regPhone}}" bindinput="onRegPhone" />
      </view>
      <view class="field">
        <view class="label">邮箱</view>
        <input class="input" placeholder="请输入邮箱（用于找回密码）" value="{{regEmail}}" bindinput="onRegEmail" />
      </view>
      <view class="field">
        <view class="label">密码</view>
        <input class="input" password placeholder="设置密码（至少 6 位）" value="{{regPassword}}" bindinput="onRegPassword" />
      </view>
      <button class="btn-primary login-btn" bindtap="onRegister" disabled="{{submitting}}">注册</button>
    </block>

    <view class="notice">仅限本校学生使用，注册成功赠送 10 积分</view>
  </view>
</view>

<view class="modal-mask" wx:if="{{showForgotModal}}" bindtap="hideForgot">
  <view class="modal" catchtap="">
    <view class="modal-title">忘记密码</view>
    <view class="modal-text">请联系管理员 QQ：1958979757 重置密码</view>
    <button class="btn-primary" bindtap="hideForgot">知道了</button>
  </view>
</view>
