<view class="page">
  <view class="goods-bar" wx:if="{{goods}}" bindtap="onGoodsTap">
    <image class="goods-thumb" src="{{goods.cover}}" mode="aspectFill" />
    <view class="flex-1">
      <view class="goods-title">{{goods.title}}</view>
      <view class="row">
        <text class="price">￥{{goods.priceText}}</text>
        <text class="tag goods-status {{goods.status === 'on' ? 'tag-green' : 'tag-gray'}}">{{goods.statusText}}</text>
      </view>
    </view>
  </view>

  <view class="order-bar" wx:if="{{order}}">
    <block wx:if="{{order.status === 'completed'}}">
      <text class="order-done">交易已完成 ✓</text>
      <text class="order-sub">商品已标记成交并下架</text>
      <text class="order-review" bindtap="onReview">去评价</text>
    </block>
    <block wx:elif="{{order.status === 'cancelled'}}">
      <text class="order-cancel">交易已取消</text>
    </block>
    <block wx:else>
      <view class="row">
        <text class="order-ing">交易进行中</text>
        <text wx:if="{{order.sellerConfirmed && order.buyerConfirmed}}" class="order-sub">双方已确认</text>
      </view>
      <view class="row confirm-row">
        <view class="confirm-item {{order.sellerConfirmed ? 'confirmed' : ''}}">
          <text>{{order.sellerConfirmed ? '卖家已确认' : '卖家未确认'}}</text>
        </view>
        <view class="confirm-item {{order.buyerConfirmed ? 'confirmed' : ''}}">
          <text>{{order.buyerConfirmed ? '买家已确认' : '买家未确认'}}</text>
        </view>
      </view>
      <view class="row order-actions">
        <button wx:if="{{isBuyer && !order.buyerConfirmed}}" class="btn-primary confirm-btn" bindtap="onConfirm">买家确认成交</button>
        <button wx:if="{{isSeller && !order.sellerConfirmed}}" class="btn-primary confirm-btn" bindtap="onConfirm">卖家确认成交</button>
        <button wx:if="{{order.status === 'ongoing' && !order.sellerConfirmed && !order.buyerConfirmed}}" class="btn-plain cancel-btn" bindtap="onCancelOrder">取消交易</button>
      </view>
    </block>
  </view>

  <scroll-view scroll-y class="msg-area" scroll-into-view="{{lastMsgId}}" scroll-with-animation>
    <view wx:for="{{messages}}" wx:key="_id" id="msg-{{item._id}}" class="msg-row {{item.mine ? 'mine' : ''}}">
      <view class="bubble">{{item.content}}</view>
      <view class="msg-time">{{item.timeText}}</view>
    </view>
    <view wx:if="{{!messages.length && !loading}}" class="empty">打个招呼，聊聊商品吧</view>
  </scroll-view>

  <view class="input-bar safe-bottom">
    <input class="msg-input" placeholder="输入消息…" value="{{input}}" bindinput="onInput" confirm-type="send" bindconfirm="onSend" />
    <button class="btn-primary send-btn" bindtap="onSend" disabled="{{sending}}">发送</button>
  </view>
</view>
