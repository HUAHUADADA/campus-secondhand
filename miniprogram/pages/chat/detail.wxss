.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #F5F6FA;
}

.goods-bar {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  padding: 16rpx 24rpx;
  border-bottom: 2rpx solid #F0F1F5;
}

.goods-thumb {
  width: 88rpx;
  height: 88rpx;
  border-radius: 12rpx;
  background: #F0F1F5;
  margin-right: 16rpx;
}

.goods-title {
  font-size: 26rpx;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.goods-status {
  margin-left: 16rpx;
}

.order-bar {
  background: #FFFFFF;
  padding: 16rpx 24rpx;
  border-bottom: 2rpx solid #F0F1F5;
}

.order-done {
  color: #0EA371;
  font-size: 28rpx;
  font-weight: 700;
}

.order-cancel {
  color: #6B7280;
  font-size: 28rpx;
}

.order-ing {
  color: #4F46E5;
  font-size: 28rpx;
  font-weight: 700;
}

.order-sub {
  font-size: 22rpx;
  color: #9AA0A6;
  margin-left: 16rpx;
}

.order-review {
  font-size: 24rpx;
  color: #4F46E5;
  margin-left: 16rpx;
}

.confirm-row {
  margin-top: 12rpx;
}

.confirm-item {
  padding: 6rpx 20rpx;
  border-radius: 24rpx;
  font-size: 22rpx;
  color: #9AA0A6;
  background: #F0F1F5;
  margin-right: 16rpx;
}

.confirm-item.confirmed {
  color: #0EA371;
  background: rgba(16, 185, 129, 0.12);
}

.order-actions {
  margin-top: 16rpx;
}

.confirm-btn {
  flex: 1;
  font-size: 26rpx;
  line-height: 2.2;
  margin: 0;
}

.cancel-btn {
  font-size: 24rpx;
  line-height: 2.2;
  margin-left: 16rpx;
  padding: 0 24rpx;
}

.msg-area {
  flex: 1;
  overflow: hidden;
  padding: 24rpx;
}

.msg-row {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  margin-bottom: 24rpx;
}

.msg-row.mine {
  align-items: flex-end;
}

.bubble {
  max-width: 70%;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 16rpx 24rpx;
  font-size: 28rpx;
  line-height: 1.5;
  word-break: break-all;
}

.mine .bubble {
  background: #4F46E5;
  color: #FFFFFF;
}

.msg-time {
  font-size: 20rpx;
  color: #C7CBD9;
  margin-top: 8rpx;
}

.input-bar {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #FFFFFF;
}

.msg-input {
  flex: 1;
  background: #F5F6FA;
  border-radius: 40rpx;
  padding: 16rpx 28rpx;
  font-size: 28rpx;
}

.send-btn {
  margin-left: 16rpx;
  padding: 0 36rpx;
  font-size: 28rpx;
  line-height: 2.4;
}
