<view class="page">
  <view class="search-box">
    <input class="input kw" placeholder="关键词（书名 / 标题 / 描述）" value="{{keyword}}" bindinput="onKeywordInput" confirm-type="search" bindconfirm="onSearch" />
    <input class="input kw" placeholder="ISBN（可选，教材专用）" value="{{isbn}}" bindinput="onIsbnInput" confirm-type="search" bindconfirm="onSearch" />
    <button class="btn-primary search-btn" bindtap="onSearch">搜索</button>
  </view>

  <view class="goods-list">
    <view wx:for="{{goodsList}}" wx:key="_id" class="goods-card" data-id="{{item._id}}" bindtap="onGoodsTap">
      <image class="goods-img" src="{{item.cover}}" mode="aspectFill" />
      <view class="goods-info">
        <view class="goods-title">{{item.title}}</view>
        <view class="goods-sub" wx:if="{{item.bookName}}">《{{item.bookName}}》</view>
        <view class="goods-sub" wx:if="{{item.isbn}}">ISBN {{item.isbn}}</view>
        <view class="goods-bottom">
          <text class="price goods-price">￥{{item.priceText}}</text>
          <text class="goods-seller">{{item.sellerName}} · {{item.timeText}}</text>
        </view>
      </view>
    </view>
    <view wx:if="{{searched && !goodsList.length && !loading}}" class="empty">没有找到相关商品，换个关键词试试</view>
    <view wx:if="{{loading}}" class="empty">加载中…</view>
  </view>
</view>
