.page {
  padding: 24rpx;
}

.goods-card {
  display: flex;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
}

.goods-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 16rpx;
  background: #F0F1F5;
  flex-shrink: 0;
}

.goods-info {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
}

.goods-title {
  font-size: 30rpx;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.goods-bottom {
  margin-top: auto;
}

.goods-bottom .price {
  font-size: 30rpx;
}

.remove {
  margin-left: auto;
  font-size: 22rpx;
  color: #9AA0A6;
  padding: 8rpx 0 8rpx 16rpx;
}
