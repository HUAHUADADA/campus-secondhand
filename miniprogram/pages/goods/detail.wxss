.page {
  padding-bottom: 140rpx;
}

.swiper {
  width: 100%;
  height: 600rpx;
  background: #F0F1F5;
}

.swiper-img {
  width: 100%;
  height: 100%;
}

.title-price {
  font-size: 44rpx;
}

.title {
  font-size: 34rpx;
  font-weight: 700;
  margin-top: 12rpx;
  line-height: 1.5;
}

.book-info {
  margin-top: 16rpx;
  background: #F7F7FF;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
}

.book-line {
  font-size: 26rpx;
  color: #4E5566;
  line-height: 1.6;
}

.meta {
  font-size: 24rpx;
  color: #9AA0A6;
  margin-top: 16rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
}

.desc {
  font-size: 28rpx;
  color: #4E5566;
  line-height: 1.7;
  white-space: pre-wrap;
}

.seller-card {
  display: flex;
  align-items: center;
}

.seller-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #4F46E5;
  color: #FFFFFF;
  font-size: 34rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.seller-name {
  font-size: 30rpx;
  font-weight: 600;
}

.seller-sub {
  font-size: 24rpx;
  color: #9AA0A6;
  margin-top: 4rpx;
}

.action-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #FFFFFF;
  box-shadow: 0 -4rpx 16rpx rgba(31, 35, 41, 0.06);
}

.action-icon {
  margin-right: 40rpx;
  padding: 8rpx 0;
}

.action-text {
  font-size: 26rpx;
  color: #4E5566;
}

.action-btn {
  min-width: 200rpx;
  margin-left: 20rpx;
}
